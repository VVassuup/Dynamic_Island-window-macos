<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island" Width="480" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="{DynamicResource UiFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Animated" RenderOptions.BitmapScalingMode="HighQuality">

    <!--
        Интерфейс повторяет macOS-версию (IslandView.swift):
        те же размеры, отступы, кегли, порядок кнопок и цвета.
        Шрифт: SF Pro Text вшит в программу (Assets\Fonts), устанавливать его в Windows не нужно.
    -->

    <Window.Resources>
        <FontFamily x:Key="UiFont">pack://application:,,,/Assets/Fonts/#SF Pro Text, Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="RoundedFont">pack://application:,,,/Assets/Fonts/#SF Pro Text, Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- цвет текста/иконок; пересчитываются из кода (тёмный остров — белый, светлый — чёрный) -->
        <SolidColorBrush x:Key="AccentBrush" Color="White" />
        <SolidColorBrush x:Key="Fg" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="Fg75" Color="#BFFFFFFF" />
        <SolidColorBrush x:Key="Fg65" Color="#A6FFFFFF" />
        <SolidColorBrush x:Key="Fg60" Color="#99FFFFFF" />
        <SolidColorBrush x:Key="Fg55" Color="#8CFFFFFF" />
        <SolidColorBrush x:Key="Fg50" Color="#80FFFFFF" />
        <SolidColorBrush x:Key="Fg45" Color="#73FFFFFF" />
        <SolidColorBrush x:Key="Fg40" Color="#66FFFFFF" />
        <SolidColorBrush x:Key="Fg18" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="Fg16" Color="#29FFFFFF" />
        <SolidColorBrush x:Key="Fg14" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="Fg10" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="Fg09" Color="#17FFFFFF" />
        <SolidColorBrush x:Key="Fg08" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="Fg07" Color="#12FFFFFF" />

        <!-- Круглая кнопка-иконка 28×28 (IconButton в macOS) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg75}" />
            <Setter Property="Background" Value="{DynamicResource Fg08}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="G" Background="Transparent">
                            <Ellipse Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="G" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="on">
                    <Setter Property="Background" Value="{DynamicResource Fg16}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Вкладка-капсула «Музыка» / «Система» (TabButton в macOS) -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg50}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="on">
                    <Setter Property="Background" Value="{DynamicResource Fg14}" />
                    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Кнопки плеера без фона, как .buttonStyle(.plain) -->
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="G" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="G" Property="Opacity" Value="0.55" />
                                <Setter TargetName="G" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Полоса перемотки 4 px с круглым бегунком 8 px (12 px при перетаскивании) -->
        <Style x:Key="SliderRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="12" />
                                <Setter TargetName="Dot" Property="Height" Value="12" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeekSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRepeat}" Background="{DynamicResource AccentBrush}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRepeat}" Background="{DynamicResource Fg18}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Карточка на странице «Система» (StatCard в macOS) -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Fg07}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="5" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Fg50}" />
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource RoundedFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="CardSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Fg55}" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="BarTrack" TargetType="Border">
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{DynamicResource Fg14}" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style x:Key="BarFill" TargetType="Border">
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="RenderTransformOrigin" Value="0,0.5" />
        </Style>

        <Style x:Key="EqBar" TargetType="Rectangle">
            <Setter Property="Width" Value="3" />
            <Setter Property="RadiusX" Value="1.5" />
            <Setter Property="RadiusY" Value="1.5" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <!-- подложка под свечение/тень: эффект висит на ней, а не на самом острове,
             поэтому текст острова рисуется чётко (ClearType), а свечение уходит и вверх -->
        <Border x:Name="GlowLayer" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="36,40,36,40" Width="120" Height="34" CornerRadius="17" Background="Black"
                IsHitTestVisible="False" Visibility="Collapsed" />

        <Border x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="36,40,36,40" Width="120" Height="34" CornerRadius="17" Background="Black"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave" SizeChanged="Island_SizeChanged"
                TextElement.Foreground="{DynamicResource Fg}">
            <Grid x:Name="IslandContent">

                <!-- ======================== СВЁРНУТЫЙ ======================== -->
                <Grid x:Name="CompactView" Margin="7,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="MiniCoverHost" Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center">
                        <Border x:Name="MiniCover" CornerRadius="6" Background="{DynamicResource Fg10}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform x:Name="MiniDiscRotate" />
                            </Border.RenderTransform>
                            <Grid>
                                <Border x:Name="MiniCoverImg" CornerRadius="6">
                                    <Border.Background>
                                        <ImageBrush x:Name="MiniCoverBrush" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Ellipse x:Name="MiniHole" Width="4" Height="4" Fill="Black" Stroke="#33FFFFFF" StrokeThickness="0.5" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="ClockText" Grid.Column="1" Text="00:00" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{DynamicResource RoundedFont}" FontSize="14" FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource Fg}" />

                    <!-- строка текста: старая уезжает вверх, новая плавно поднимается снизу.
                         Ideal + Animated — субпиксельное движение без «ступенек» в конце анимации -->
                    <TextBlock x:Name="CompactLyricOld" Grid.Column="1" Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fg}"
                               Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                               TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Animated">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="CompactLyricOldShift" />
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <TextBlock x:Name="CompactLyric" Grid.Column="1" Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fg}"
                               Visibility="Collapsed"
                               TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Animated">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="CompactLyricShift" />
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <StackPanel x:Name="EqBars" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="12" Margin="0,0,2,0">
                        <Rectangle Style="{StaticResource EqBar}" Height="12"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle Style="{StaticResource EqBar}" Height="12"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.7" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle Style="{StaticResource EqBar}" Height="12"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.5" /></Rectangle.RenderTransform></Rectangle>
                        <Rectangle Style="{StaticResource EqBar}" Height="12"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.8" /></Rectangle.RenderTransform></Rectangle>
                    </StackPanel>
                </Grid>

                <!-- ======================== РАЗВЁРНУТЫЙ ======================== -->
                <StackPanel x:Name="ExpandedView" Width="364" Margin="18" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0">

                    <!-- верхняя строка: вкладки слева, «недавние» и «настройки» справа -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="TabMusic" Style="{StaticResource TabButton}" Content="{DynamicResource L_tab_music}" Click="TabMusic_Click" Tag="on" />
                            <Button x:Name="TabSystem" Style="{StaticResource TabButton}" Content="{DynamicResource L_tab_system}" Click="TabSystem_Click" Margin="4,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="RecentButton" Style="{StaticResource IconButton}" Content="&#xE81C;" Click="Recent_Click" ToolTip="{DynamicResource L_tip_recent}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="Settings_Click" Margin="8,0,0,0" ToolTip="{DynamicResource L_tip_settings}" />
                        </StackPanel>
                    </Grid>

                    <!-- ===== Музыка ===== -->
                    <StackPanel x:Name="MusicPage" Margin="0,14,0,0">

                        <!-- ничего не играет -->
                        <StackPanel x:Name="NothingPanel" Margin="0,22" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{DynamicResource Fg40}" HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource L_media_nothing}" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource Fg}" />
                            <TextBlock Text="{DynamicResource L_media_hint}" FontSize="11.5" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Fg50}" />
                        </StackPanel>

                        <!-- играет трек -->
                        <StackPanel x:Name="TrackPanel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="CoverBox" Grid.Column="0" Width="58" Height="58" CornerRadius="12" Background="{DynamicResource Fg10}" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                    <Border.RenderTransform>
                                        <RotateTransform x:Name="DiscRotate" />
                                    </Border.RenderTransform>
                                    <Grid>
                                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource Fg40}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border x:Name="Cover" CornerRadius="12">
                                            <Border.Background>
                                                <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <Ellipse x:Name="DiscRing" Stroke="#26FFFFFF" StrokeThickness="1" Visibility="Collapsed" />
                                        <Ellipse x:Name="DiscHole" Width="9" Height="9" Fill="Black" Stroke="#40FFFFFF" StrokeThickness="1" Visibility="Collapsed" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fg}" />
                                    <TextBlock x:Name="ArtistText" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fg65}" />
                                    <TextBlock x:Name="SourceText" FontSize="10" FontWeight="Medium" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AccentBrush}" Opacity="0.9" />
                                </StackPanel>

                                <!-- ползунок громкости, как VolumePill в macOS -->
                                <Grid x:Name="VolumeHost" Grid.Column="2" Width="22" Height="54" Background="Transparent" Cursor="Hand" VerticalAlignment="Center"
                                      MouseEnter="Volume_MouseEnter" MouseLeave="Volume_MouseLeave"
                                      MouseLeftButtonDown="Volume_Down" MouseMove="Volume_Move" MouseLeftButtonUp="Volume_Up"
                                      LostMouseCapture="Volume_LostCapture" MouseWheel="Volume_Wheel"
                                      ToolTipService.InitialShowDelay="600">
                                    <Grid x:Name="VolumePill" Width="16" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" SizeChanged="VolumePill_SizeChanged">
                                        <Rectangle Fill="{DynamicResource Fg16}" />
                                        <Rectangle x:Name="VolumeFill" Fill="{DynamicResource Fg}" VerticalAlignment="Bottom" Height="22" />
                                        <TextBlock x:Name="VolumeIcon" Text="&#xE994;" FontFamily="{StaticResource IconFont}" FontSize="8" FontWeight="Normal"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                                    </Grid>
                                </Grid>

                                <StackPanel x:Name="EqBarsBig" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="18" Visibility="Collapsed">
                                    <Rectangle Style="{StaticResource EqBar}" Height="18"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4" /></Rectangle.RenderTransform></Rectangle>
                                    <Rectangle Style="{StaticResource EqBar}" Height="18"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.7" /></Rectangle.RenderTransform></Rectangle>
                                    <Rectangle Style="{StaticResource EqBar}" Height="18"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.5" /></Rectangle.RenderTransform></Rectangle>
                                    <Rectangle Style="{StaticResource EqBar}" Height="18"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.8" /></Rectangle.RenderTransform></Rectangle>
                                    <Rectangle Style="{StaticResource EqBar}" Height="18"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.6" /></Rectangle.RenderTransform></Rectangle>
                                </StackPanel>
                            </Grid>

                            <!-- текст песни -->
                            <StackPanel x:Name="LyricsPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="LyricCurrent" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           TextOptions.TextRenderingMode="Grayscale"
                                           MaxHeight="40" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock x:Name="LyricNext" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fg45}" />
                            </StackPanel>

                            <!-- перемотка -->
                            <StackPanel x:Name="SeekPanel" Margin="0,12,0,0">
                                <Slider x:Name="ProgressSlider" Style="{StaticResource SeekSlider}" Maximum="1"
                                        PreviewMouseLeftButtonDown="Progress_Down" PreviewMouseLeftButtonUp="Progress_Up" />
                                <Grid Margin="0,4,0,0" TextElement.FontSize="10" TextElement.FontWeight="Medium">
                                    <TextBlock x:Name="ElapsedText" Text="0:00" HorizontalAlignment="Left" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource Fg55}" />
                                    <TextBlock x:Name="RemainingText" Text="-0:00" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource Fg55}" />
                                </Grid>
                            </StackPanel>

                            <!-- управление: назад / пауза / вперёд по центру -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <Button Style="{StaticResource PlainButton}" Width="38" Height="34" Click="Prev_Click">
                                    <Path Data="M11,0 L11,14 L0,7 Z M24,0 L24,14 L13,7 Z" Fill="{DynamicResource Fg}" Stroke="{DynamicResource Fg}"
                                          StrokeThickness="1.2" StrokeLineJoin="Round" Width="21" Height="12.5" Stretch="Fill" />
                                </Button>
                                <Button x:Name="PlayPauseButton" Style="{StaticResource PlainButton}" Width="46" Height="42" Margin="34,0" Click="PlayPause_Click">
                                    <Grid>
                                        <Path x:Name="PlayIcon" Data="M0,0 L0,24 L20,12 Z" Fill="{DynamicResource Fg}" Stroke="{DynamicResource Fg}"
                                              StrokeThickness="2" StrokeLineJoin="Round" Width="19" Height="22" Stretch="Fill" Margin="3,0,0,0"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform><ScaleTransform /></Path.RenderTransform>
                                        </Path>
                                        <Path x:Name="PauseIcon" Data="M0,0 H6 V24 H0 Z M12,0 H18 V24 H12 Z" Fill="{DynamicResource Fg}" Stroke="{DynamicResource Fg}"
                                              StrokeThickness="1.2" StrokeLineJoin="Round" Width="17" Height="21" Stretch="Fill"
                                              RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                            <Path.RenderTransform><ScaleTransform /></Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource PlainButton}" Width="38" Height="34" Click="Next_Click">
                                    <Path Data="M0,0 L0,14 L11,7 Z M13,0 L13,14 L24,7 Z" Fill="{DynamicResource Fg}" Stroke="{DynamicResource Fg}"
                                          StrokeThickness="1.2" StrokeLineJoin="Round" Width="21" Height="12.5" Stretch="Fill" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- ===== Недавние треки ===== -->
                    <StackPanel x:Name="RecentPanel" Margin="0,14,0,0" Visibility="Collapsed">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource L_recent_title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                            <TextBlock Text="{DynamicResource L_recent_rmb}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Fg45}" />
                        </Grid>
                        <TextBlock x:Name="RecentEmpty" Text="{DynamicResource L_recent_empty}" FontSize="12" Margin="0,18" HorizontalAlignment="Center" Foreground="{DynamicResource Fg50}" />
                        <ItemsControl x:Name="RecentList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Tag="{Binding}" Cursor="Hand" Background="Transparent" CornerRadius="10" Padding="6" Margin="0,3,0,0"
                                            MouseLeftButtonUp="RecentItem_Click" MouseRightButtonUp="RecentItem_RightClick">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="7" Background="{DynamicResource Fg10}">
                                                <Border CornerRadius="7">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fg}" />
                                                <TextBlock Text="{Binding Artist}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fg55}" />
                                            </StackPanel>
                                            <Border x:Name="Badge" Grid.Column="2" CornerRadius="8" Padding="7,2" Background="{DynamicResource Fg10}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PlatformShort}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource Fg}" Opacity="0.7" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Fg09}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding PlatformShort}" Value="">
                                            <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ===== Система ===== -->
                    <StackPanel x:Name="SystemPage" Margin="0,14,0,0" Visibility="Collapsed">
                        <Grid>
                            <TextBlock Text="{DynamicResource L_sys_title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                            <TextBlock x:Name="UptimeText" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Fg50}" />
                        </Grid>
                        <UniformGrid Columns="2" Margin="-5,5,-5,-5">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource L_sys_cpu}" />
                                    <TextBlock x:Name="CpuValue" Style="{StaticResource CardValue}" Text="0%" />
                                    <Border Style="{StaticResource BarTrack}">
                                        <Border x:Name="CpuBar" Style="{StaticResource BarFill}"><Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform></Border>
                                    </Border>
                                    <TextBlock x:Name="CpuSub" Style="{StaticResource CardSub}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource L_sys_ram}" />
                                    <TextBlock x:Name="RamValue" Style="{StaticResource CardValue}" Text="0%" />
                                    <Border Style="{StaticResource BarTrack}">
                                        <Border x:Name="RamBar" Style="{StaticResource BarFill}"><Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform></Border>
                                    </Border>
                                    <TextBlock x:Name="RamSub" Style="{StaticResource CardSub}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource L_sys_disk}" />
                                    <TextBlock x:Name="DiskValue" Style="{StaticResource CardValue}" Text="0%" />
                                    <Border Style="{StaticResource BarTrack}">
                                        <Border x:Name="DiskBar" Style="{StaticResource BarFill}"><Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform></Border>
                                    </Border>
                                    <TextBlock x:Name="DiskSub" Style="{StaticResource CardSub}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource L_sys_net}" />
                                    <TextBlock x:Name="NetDown" Style="{StaticResource CardValue}" Text="↓ 0" />
                                    <TextBlock x:Name="NetUp" Style="{StaticResource CardSub}" Text="↑ 0" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="BatteryCard" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource L_sys_battery}" />
                                    <TextBlock x:Name="BatteryValue" Style="{StaticResource CardValue}" Text="0%" />
                                    <Border Style="{StaticResource BarTrack}">
                                        <Border x:Name="BatteryBar" Style="{StaticResource BarFill}"><Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform></Border>
                                    </Border>
                                    <TextBlock x:Name="BatterySub" Style="{StaticResource CardSub}" Text=" " />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>

                <!-- ======================== УВЕДОМЛЕНИЕ ======================== -->
                <Grid x:Name="NotificationView" Width="352" Margin="14" VerticalAlignment="Top" Cursor="Hand"
                      Background="Transparent" Visibility="Collapsed" Opacity="0" MouseLeftButtonUp="Notification_Click">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="38" Height="38" VerticalAlignment="Top">
                        <TextBlock x:Name="NotifGlyph" Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                        <Border x:Name="NotifIconImg" CornerRadius="9">
                            <Border.Background>
                                <ImageBrush x:Name="NotifIconBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <Grid>
                            <TextBlock x:Name="NotifApp" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,44,0" Foreground="{DynamicResource Fg55}" />
                            <TextBlock Text="{DynamicResource L_notif_now}" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource Fg40}" />
                        </Grid>
                        <TextBlock x:Name="NotifTitle" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fg}" />
                        <TextBlock x:Name="NotifBody" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48" Foreground="{DynamicResource Fg75}" />
                    </StackPanel>
                </Grid>

                <!-- ======================== СОБЫТИЕ: раскладка · зарядка · наушники ======================== -->
                <Grid x:Name="ActivityView" Margin="14,0" VerticalAlignment="Center" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="18" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ActivityGlyph" Grid.Column="0" FontFamily="{StaticResource IconFont}" FontSize="16"
                               VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="ActivityTitle" Grid.Column="1" Margin="9,0,0,0" MaxWidth="190" TextTrimming="CharacterEllipsis"
                               FontFamily="{DynamicResource RoundedFont}" FontSize="12.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource Fg}" />
                    <TextBlock x:Name="ActivityValue" Grid.Column="3"
                               FontFamily="{DynamicResource RoundedFont}" FontSize="13.5" FontWeight="Bold"
                               VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
