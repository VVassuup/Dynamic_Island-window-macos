<Window x:Class="DynamicIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_set_wintitle}" Icon="pack://application:,,,/Assets/app.ico" Width="430" Height="740"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" KeyDown="Window_KeyDown"
        FontFamily="pack://application:,,,/Assets/Fonts/#SF Pro Text, Segoe UI Variable Text, Segoe UI" Foreground="White"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Animated" RenderOptions.BitmapScalingMode="HighQuality">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E8E93" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="16,20,0,7" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E8E93" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="16,6,16,0" />
        </Style>

        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E8E93" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#2C2C2E" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,4" />
        </Style>

        <Style x:Key="Line" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="#3A3A3C" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- iOS-переключатель -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Grid Grid.Column="1" Width="46" Height="28">
                                <Border CornerRadius="14" Background="#39393D" />
                                <Border x:Name="OnFill" CornerRadius="14" Background="#34C759" Opacity="0" />
                                <Ellipse x:Name="Knob" Width="24" Height="24" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="OnFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="18" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.35" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="OnFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.35" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS-слайдер -->
        <Style x:Key="TrackPart" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KnobThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="24" Height="24" Fill="White">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackPart}" Background="#0A84FF" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackPart}" Background="#48484A" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource KnobThumb}" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- круглые образцы цвета -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" />
                            <Ellipse Margin="4" Fill="{TemplateBinding Background}" Stroke="#48484A" StrokeThickness="1" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- чипы выбора площадки -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="15" Background="#3A3A3C" Padding="13,6">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0A84FF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#0A84FF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" Padding="0,11">
                            <ContentPresenter HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Width="30" Height="30" CornerRadius="15" Background="#3A3A3C">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                       Foreground="#AEAEB2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#48484A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#3A3A3C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="8,4">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" Background="#F21C1C1E" BorderBrush="#26FFFFFF" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- заголовок (за него можно таскать окно) -->
            <Grid Background="Transparent" Margin="20,16,16,6" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app-64.png" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{DynamicResource L_set_title}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Click="Close_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,0,0,12">
                <StackPanel Margin="16,0,16,16">

                    <!-- ПРЕВЬЮ -->
                    <Border CornerRadius="14" Height="92" Margin="0,6,0,0" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF5E5CE6" Offset="0" />
                                <GradientStop Color="#FFFF375F" Offset="0.55" />
                                <GradientStop Color="#FFFF9F0A" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border x:Name="PreviewPill" Width="190" Height="38" CornerRadius="19" Background="Black"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Margin="14,0">
                                <TextBlock x:Name="PreviewText" Text="{DynamicResource L_set_preview}" FontSize="13" VerticalAlignment="Center" />
                                <Ellipse x:Name="PreviewDot" Width="8" Height="8" Fill="White" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </Border>

                    <!-- ВНЕШНИЙ ВИД -->
                    <TextBlock Style="{StaticResource Section}" Text="{DynamicResource L_set_appearance}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="{DynamicResource L_set_size}" />
                                <TextBlock x:Name="ScaleValue" Style="{StaticResource Value}" />
                            </Grid>
                            <Slider x:Name="ScaleSlider" Minimum="0.7" Maximum="1.6" ValueChanged="SliderChanged" />
                            <Rectangle Style="{StaticResource Line}" />
                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="{DynamicResource L_set_offset}" />
                                <TextBlock x:Name="OffsetValue" Style="{StaticResource Value}" />
                            </Grid>
                            <Slider x:Name="OffsetSlider" Minimum="0" Maximum="60" ValueChanged="SliderChanged" />
                            <Rectangle Style="{StaticResource Line}" />
                            <CheckBox x:Name="ShadowBox" Style="{StaticResource Switch}" Content="{DynamicResource L_set_shadow}" Click="Changed" />
                            <Rectangle Style="{StaticResource Line}" />
                            <CheckBox x:Name="VinylBox" Style="{StaticResource Switch}" Content="{DynamicResource L_set_vinyl}" Click="Changed" />
                        </StackPanel>
                    </Border>

                    <!-- ЦВЕТ -->
                    <TextBlock Style="{StaticResource Section}" Text="{DynamicResource L_set_color}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L_set_panelcolor}" Margin="0,12,0,10" />
                            <StackPanel x:Name="ColorSwatches" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Style="{StaticResource Swatch}" Tag="#000000" Background="#000000" Click="Swatch_Click" />
                                <Button Style="{StaticResource Swatch}" Tag="#1C1C1E" Background="#1C1C1E" Click="Swatch_Click" />
                                <Button Style="{StaticResource Swatch}" Tag="#0A1A3A" Background="#0A1A3A" Click="Swatch_Click" />
                                <Button Style="{StaticResource Swatch}" Tag="#2A1040" Background="#2A1040" Click="Swatch_Click" />
                                <Button Style="{StaticResource Swatch}" Tag="#0F2A1A" Background="#0F2A1A" Click="Swatch_Click" />
                                <Button Style="{StaticResource Swatch}" Tag="#3A0E14" Background="#3A0E14" Click="Swatch_Click" />
                            </StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource L_set_hex}" VerticalAlignment="Center" Foreground="#AEAEB2" />
                                <TextBox x:Name="ColorBox" Width="110" Height="30" HorizontalAlignment="Right"
                                         KeyDown="ColorBox_KeyDown" LostFocus="ColorBox_LostFocus" />
                            </Grid>
                            <Rectangle Style="{StaticResource Line}" />
                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="{DynamicResource L_set_opacity}" />
                                <TextBlock x:Name="OpacityValue" Style="{StaticResource Value}" />
                            </Grid>
                            <Slider x:Name="OpacitySlider" Minimum="15" Maximum="100" ValueChanged="SliderChanged" />
                            <Rectangle Style="{StaticResource Line}" />
                            <TextBlock Text="{DynamicResource L_set_bg}" Margin="0,12,0,10" />
                            <WrapPanel Margin="0,0,0,4">
                                <RadioButton x:Name="BgSolid" Style="{StaticResource Chip}" GroupName="bg" Tag="solid" Content="{DynamicResource L_set_bg_solid}" Checked="BgMode_Checked" />
                                <RadioButton x:Name="BgCover" Style="{StaticResource Chip}" GroupName="bg" Tag="cover" Content="{DynamicResource L_set_bg_cover}" Checked="BgMode_Checked" />
                                <RadioButton x:Name="BgCustom" Style="{StaticResource Chip}" GroupName="bg" Tag="custom" Content="{DynamicResource L_set_bg_custom}" Checked="BgMode_Checked" />
                            </WrapPanel>
                            <StackPanel x:Name="GradientPanel">
                                <StackPanel x:Name="GradientSwatches" Orientation="Horizontal" Margin="0,2,0,10">
                                    <Button Style="{StaticResource Swatch}" Tag="#FF375F" Background="#FF375F" Click="Gradient_Click" />
                                    <Button Style="{StaticResource Swatch}" Tag="#BF5AF2" Background="#BF5AF2" Click="Gradient_Click" />
                                    <Button Style="{StaticResource Swatch}" Tag="#0A84FF" Background="#0A84FF" Click="Gradient_Click" />
                                    <Button Style="{StaticResource Swatch}" Tag="#30D158" Background="#30D158" Click="Gradient_Click" />
                                    <Button Style="{StaticResource Swatch}" Tag="#FF9F0A" Background="#FF9F0A" Click="Gradient_Click" />
                                    <Button Style="{StaticResource Swatch}" Tag="#C8906A" Background="#C8906A" Click="Gradient_Click" />
                                </StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="{DynamicResource L_set_gradhex}" VerticalAlignment="Center" Foreground="#AEAEB2" />
                                    <TextBox x:Name="GradientBox" Width="110" Height="30" HorizontalAlignment="Right"
                                             KeyDown="GradientBox_KeyDown" LostFocus="GradientBox_LostFocus" />
                                </Grid>
                            </StackPanel>
                            <Rectangle Style="{StaticResource Line}" />
                            <CheckBox x:Name="GlowBox" Style="{StaticResource Switch}" Content="{DynamicResource L_set_glow}" Click="Changed" />
                            <Rectangle Style="{StaticResource Line}" />
                            <CheckBox x:Name="AccentCoverBox" Style="{StaticResource Switch}" Content="{DynamicResource L_set_accentcover}" Click="Changed" />
                            <StackPanel x:Name="AccentSwatches" Orientation="Horizontal" Margin="0,2,0,12">
                                <Button Style="{StaticResource Swatch}" Tag="#FFFFFF" Background="#FFFFFF" Click="Accent_Click" />
                                <Button Style="{StaticResource Swatch}" Tag="#0A84FF" Background="#0A84FF" Click="Accent_Click" />
                                <Button Style="{StaticResource Swatch}" Tag="#34C759" Background="#34C759" Click="Accent_Click" />
                                <Button Style="{StaticResource Swatch}" Tag="#FF9F0A" Background="#FF9F0A" Click="Accent_Click" />
                                <Button Style="{StaticResource Swatch}" Tag="#FF375F" Background="#FF375F" Click="Accent_Click" />
                                <Button Style="{StaticResource Swatch}" Tag="#BF5AF2" Background="#BF5AF2" Click="Accent_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- МУЗЫКА -->
                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource L_set_bghint}" />

                    <TextBlock Style="{StaticResource Section}" Text="{DynamicResource L_set_music}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="VolumeBox" Style="{StaticResource Switch}" Content="{DynamicResource L_set_volume}" Click="Changed" />
                            <Rectangle Style="{StaticResource Line}" />
                            <CheckBox x:Name="LyricsBox" Style="{StaticResource Switch}" Content="{DynamicResource L_set_lyrics}" Click="Changed" />
                            <Rectangle Style="{StaticResource Line}" />
                            <CheckBox x:Name="CompactLyricsBox" Style="{StaticResource Switch}" Content="{DynamicResource L_set_compactlyrics}" Click="Changed" />
                            <Rectangle Style="{StaticResource Line}" />
                            <CheckBox x:Name="ClockBox" Style="{StaticResource Switch}" Content="{DynamicResource L_set_clock}" Click="Changed" />
                            <Rectangle Style="{StaticResource Line}" />
                            <TextBlock Text="{DynamicResource L_set_openrecent}" Margin="0,12,0,10" />
                            <WrapPanel x:Name="PlatformPanel" Margin="0,0,0,6" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource L_set_recenthint}" />

                    <!-- УВЕДОМЛЕНИЯ -->
                    <TextBlock Style="{StaticResource Section}" Text="{DynamicResource L_set_notifications}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="WinNotifBox" Style="{StaticResource Switch}" Content="{DynamicResource L_set_winnotif}" Click="Changed" />
                            <Rectangle Style="{StaticResource Line}" />
                            <CheckBox x:Name="TgNotifBox" Style="{StaticResource Switch}" Content="Telegram" Click="Changed" />
                            <Rectangle Style="{StaticResource Line}" />
                            <CheckBox x:Name="DndBox" Style="{StaticResource Switch}" Content="{DynamicResource L_set_dnd}" Click="Changed" />
                            <Rectangle Style="{StaticResource Line}" />
                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="{DynamicResource L_set_duration}" />
                                <TextBlock x:Name="DurationValue" Style="{StaticResource Value}" />
                            </Grid>
                            <Slider x:Name="DurationSlider" Minimum="2" Maximum="15" ValueChanged="SliderChanged" />
                            <Rectangle Style="{StaticResource Line}" />
                            <Button Style="{StaticResource PillButton}" Content="{DynamicResource L_set_test}" Click="Test_Click" />
                        </StackPanel>
                    </Border>

                    <!-- СИСТЕМА -->
                    <TextBlock Style="{StaticResource Section}" Text="{DynamicResource L_set_system}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="TopBox" Style="{StaticResource Switch}" Content="{DynamicResource L_set_top}" Click="Changed" />
                            <Rectangle Style="{StaticResource Line}" />
                            <CheckBox x:Name="FullscreenBox" Style="{StaticResource Switch}" Content="{DynamicResource L_set_fullscreen}" Click="Changed" />
                            <Rectangle Style="{StaticResource Line}" />
                            <CheckBox x:Name="AutoStartBox" Style="{StaticResource Switch}" Content="{DynamicResource L_set_autostart}" Click="AutoStart_Changed" />
                        </StackPanel>
                    </Border>

                    <!-- СОБЫТИЯ -->
                    <TextBlock Style="{StaticResource Section}" Text="{DynamicResource L_set_events}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="EvLayoutBox" Style="{StaticResource Switch}" Content="{DynamicResource L_set_ev_layout}" Click="Changed" />
                            <Rectangle Style="{StaticResource Line}" />
                            <CheckBox x:Name="EvPowerBox" Style="{StaticResource Switch}" Content="{DynamicResource L_set_ev_power}" Click="Changed" />
                            <Rectangle Style="{StaticResource Line}" />
                            <CheckBox x:Name="EvBtBox" Style="{StaticResource Switch}" Content="{DynamicResource L_set_ev_bt}" Click="Changed" />
                        </StackPanel>
                    </Border>

                    <!-- КЛИКИ СКВОЗЬ ОСТРОВ -->
                    <TextBlock Style="{StaticResource Section}" Text="{DynamicResource L_set_clicks}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="ClickThroughBox" Style="{StaticResource Switch}" Content="{DynamicResource L_set_clickthrough}" Click="Changed" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource L_set_clickhint}" />

                    <!-- ЯЗЫК / LANGUAGE -->
                    <TextBlock Style="{StaticResource Section}" Text="{DynamicResource L_set_language}" />
                    <Border Style="{StaticResource Card}">
                        <WrapPanel x:Name="LangPanel" Margin="0,12,0,6" />
                    </Border>

                    <!-- О ПРИЛОЖЕНИИ -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,26,0,6">
                        <Image Source="pack://application:,,,/Assets/app-64.png" Width="44" Height="44" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="VersionText" Text="Dynamic Island" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="created by @vvassuup" HorizontalAlignment="Center" FontSize="12" Foreground="#8E8E93" Margin="0,2,0,0" />
                        <TextBlock x:Name="TelegramLink" Text="t.me/vvassuup" HorizontalAlignment="Center" FontSize="12" Foreground="#0A84FF"
                                   Margin="0,3,0,0" Cursor="Hand" ToolTip="https://t.me/vvassuup" MouseLeftButtonUp="Telegram_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
